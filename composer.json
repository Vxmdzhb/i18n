{
    "name": "astrx/i18n",
    "description": "Translation catalogs, the catalog files the language editor writes, and diagnostic rendering.",
    "license": "LicenseRef-DoWhatever",
    "type": "library",
    "keywords": [
        "astrx",
        "no-javascript",
        "server-rendered"
    ],
    "homepage": "https://github.com/Vxmdzhb/i18n",
    "require": {
        "php": ">=8.4",
        "astrx/config": "self.version",
        "astrx/result": "self.version",
        "astrx/support": "self.version"
    },
    "suggest": {
        "ext-zend-opcache": "Invalidates cached PHP files immediately after a write"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "AstrX\\I18n\\": ""
        }
    },
    "extra": {
        "astrx": {
            "resources": "resources"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/result"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/support"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/config"
        }
    ]
}
